    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Ze5-6b-2t3">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>

                            <!-- Soft purple glow, top-leading corner -->
                            <view opaque="NO" userInteractionEnabled="NO" contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="Orb-01-vw">
                                <rect key="frame" x="-80" y="-80" width="300" height="300"/>
                                <color key="backgroundColor" red="0.4" green="0.2" blue="0.9" alpha="0.2" colorSpace="custom" customColorSpace="sRGB"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="300" id="Orb1-w"/>
                                    <constraint firstAttribute="height" constant="300" id="Orb1-h"/>
                                </constraints>
                            </view>

                            <!-- Soft blue glow, bottom-trailing corner -->
                            <view opaque="NO" userInteractionEnabled="NO" contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="Orb-02-vw">
                                <rect key="frame" x="193" y="572" width="260" height="260"/>
                                <color key="backgroundColor" red="0.1" green="0.3" blue="0.7" alpha="0.15" colorSpace="custom" customColorSpace="sRGB"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="260" id="Orb2-w"/>
                                    <constraint firstAttribute="height" constant="260" id="Orb2-h"/>
                                </constraints>
                            </view>

                            <!-- Pentago logo -->
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" image="circle_pentago_logo" translatesAutoresizingMaskIntoConstraints="NO" id="a1Y-Wh-RQR">
                                <rect key="frame" x="116.5" y="286" width="160" height="160"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="160" id="Lhk-dP-zWw"/>
                                    <constraint firstAttribute="height" constant="160" id="ma2-Im-Pwr"/>
                                </constraints>
                            </imageView>

                            <!-- "PENTAGO" title -->
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="PENTAGO" textAlignment="center" lineBreakMode="middleTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="TtL-00-TTL">
                                <rect key="frame" x="40" y="462" width="313" height="54"/>
                                <fontDescription type="boldSystem" pointSize="46"/>
                                <color key="textColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                <nil key="highlightedColor"/>
                            </label>

                            <!-- Subtitle -->
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Classic Strategy Board Game" textAlignment="center" lineBreakMode="middleTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="Sub-00-SUB">
                                <rect key="frame" x="40" y="524" width="313" height="20"/>
                                <fontDescription type="system" pointSize="15"/>
                                <color key="textColor" white="1" alpha="0.6" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                <nil key="highlightedColor"/>
                            </label>

                        </subviews>

                        <!-- Dark navy matching the app gradient start: UIColor(red:0.1, green:0.2, blue:0.45) -->
                        <color key="backgroundColor" red="0.1" green="0.2" blue="0.45" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>

                        <constraints>
                            <!-- Orb 1: top-leading corner (offset outward so it bleeds off-screen) -->
                            <constraint firstItem="Orb-01-vw" firstAttribute="leading" secondItem="Ze5-6b-2t3" secondAttribute="leading" constant="-80" id="Orb1-ld"/>
                            <constraint firstItem="Orb-01-vw" firstAttribute="top" secondItem="Ze5-6b-2t3" secondAttribute="top" constant="-80" id="Orb1-tp"/>

